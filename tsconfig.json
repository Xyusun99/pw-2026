{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "types": ["node", "@playwright/test"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./tests",
    "resolveJsonModule": true,
    "noEmit": false
  },
  "include": ["tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "evidencias"]
}
